{
  "name": "bambu-headless-bridge",
  "version": "0.1.0",
  "private": true,
  "description": "Offline Bambu Studio MCP tools on an isolated Windows desktop, with X2D dual-nozzle preparation.",
  "license": "GPL-2.0-only",
  "type": "module",
  "engines": { "node": ">=24" },
  "scripts": {
    "build:launcher": "powershell -NoProfile -ExecutionPolicy Bypass -File windows/build.ps1",
    "setup": "node scripts/setup.mjs",
    "start": "node scripts/server.mjs",
    "test": "node --test tests/*.test.mjs",
    "test:python": "python -m unittest discover -s tests -p test_dual*.py",
    "check:public": "node scripts/check-public.mjs"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "1.32.1",
    "bambu-printer-mcp": "1.1.27"
  }
}
