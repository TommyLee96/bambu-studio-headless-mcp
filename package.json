{
  "name": "bambu-studio-headless-mcp",
  "version": "0.1.0",
  "private": true,
  "description": "Bambu Studio MCP server for Windows background slicing and X2D dual-nozzle validation. 拓竹 Bambu Studio 后台切片与双喷头离线校验 MCP。",
  "keywords": ["bambu-lab", "bambulab", "bambu-studio", "mcp", "mcp-server", "model-context-protocol", "ai-agents", "headless", "windows", "3d-printing", "x2d", "dual-nozzle", "stl", "3mf", "拓竹"],
  "license": "GPL-2.0-only",
  "type": "module",
  "engines": { "node": ">=24" },
  "scripts": {
    "build:launcher": "powershell -NoProfile -ExecutionPolicy Bypass -File windows/build.ps1",
    "setup": "node scripts/setup.mjs",
    "start": "node scripts/server.mjs",
    "test": "node --test tests/*.test.mjs",
    "test:python": "python -m unittest discover -s tests -p test_dual*.py",
    "check:public": "node scripts/check-public.mjs"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "1.32.1",
    "bambu-printer-mcp": "1.1.27"
  }
}
